# ───────────────────────── Database ─────────────────────────
# docker compose up -d postgres  (port 5433 on the host)
DATABASE_URL=postgresql://app:app@localhost:5433/resturant_app

# ───────────────────────── URLs ─────────────────────────
API_PORT=4000
# Where the API is reachable from the Next.js servers
API_URL=http://localhost:4000
# Public origins (used for CORS, auth, e-mail links)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Used by the admin for "View website" links
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Website data cache in seconds (admin edits revalidate instantly anyway)
CONTENT_REVALIDATE_SECONDS=300
# Public base URL of uploaded media. Empty = served by the API at /uploads (proxied by web/admin).
MEDIA_PUBLIC_URL=

# ───────────────────────── Auth (Better Auth) ─────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First admin account (created by `pnpm db:seed` if no users exist)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Admin

# ───────────────────────── Website revalidation ─────────────────────────
# Shared secret: the API pings WEB_URL/api/revalidate when content changes.
REVALIDATE_SECRET=change-me-revalidate-secret

# ───────────────────────── Storage ─────────────────────────
# local | s3   (s3 works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
STORAGE_DRIVER=local
# Where local uploads + image cache live (default: apps/api/storage)
STORAGE_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for objects, e.g. https://cdn.example.com
S3_PUBLIC_URL=

# ───────────────────────── Payments ─────────────────────────
# Stripe — US, UK, CA, EU, AU and most of the world  (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal — US, UK, CA, EU, AU and 200+ countries; not BDT/INR  (https://developer.paypal.com/dashboard/applications)
# Webhook: <API_URL>/api/v1/payments/paypal/webhook with events CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.* → copy its Webhook ID.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true
# Razorpay — India  (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SSLCommerz — Bangladesh  (sandbox: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ───────────────────────── Bot protection ─────────────────────────
# Cloudflare Turnstile on checkout & bookings (free: https://dash.cloudflare.com → Turnstile → add site).
# Leave empty to disable. Local testing keys that always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────────────────── E-mail ─────────────────────────
# Leave SMTP_HOST empty to log e-mails to the console.
# Local catcher: docker compose --profile mail up -d  → http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="PIZZA <no-reply@example.com>"

# ───────────────────────── Misc ─────────────────────────
# Several API servers behind a load balancer: share rate-limit counters through Redis (e.g. redis://redis:6379).
REDIS_URL=
LOG_LEVEL=info
# Trust X-Forwarded-* headers (set to 1 behind a proxy / load balancer)
TRUST_PROXY=0
